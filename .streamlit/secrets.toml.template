# Study Assistant - Secrets Template
# Copy this file to secrets.toml and fill in your actual values
# NEVER commit secrets.toml to version control!

# Anthropic API (for AI features like Bubble Ace, note enhancement, etc.)
# Get your key from: https://console.anthropic.com/
[anthropic]
api_key = "sk-ant-your-key-here"

# Google Calendar OAuth (for exam sync)
# Get credentials from: https://console.cloud.google.com/
[google_calendar]
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"

# Google Vision API (for OCR)
# Create a service account and download credentials JSON
[google_vision]
credentials_path = "vision-credentials.json"

# Email notifications (optional)
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "your-email@gmail.com"
sender_password = "your-app-password"
